# ============================================
# CONFIGURATION API - TEMPLATE
# ============================================
# Copier ce fichier vers .env et remplir les valeurs reelles
# NE JAMAIS commiter le fichier .env !

# Base de donnees MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=votre_user_db
DB_PASSWORD=A_REMPLIR
DB_NAME=votre_database

# JWT (generer avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=A_GENERER_64_CARACTERES_ALEATOIRES
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=A_GENERER_AUTRE_VALEUR_64_CARACTERES
JWT_REFRESH_EXPIRES_IN=30d

# Serveur
PORT=3000
NODE_ENV=development

# CORS - origines autorisees (separes par virgule)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Fichiers
MAX_FILE_SIZE=209715200
UPLOAD_DIR=./uploads

# Mobile Money (optionnel)
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_API_SECRET=
MOOV_MONEY_API_KEY=
MOOV_MONEY_API_SECRET=
