      ]
    },
    {
      "name": "Appareils",
      "item": [
        {
          "name": "Liste Appareils",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/?route=/api/appareils"
          }
        },
        {
          "name": "Enregistrer Appareil",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Tablette Famille\",\n  \"type\": \"tablette\",\n  \"imei\": \"123456789012345\",\n  \"modele\": \"Samsung Tab A\",\n  \"systemeOs\": \"Android\",\n  \"versionOs\": \"12\"\n}"
            },
            "url": "{{baseUrl}}/?route=/api/appareils"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/?route=/api/admin/dashboard"
          }
        },
        {
          "name": "Liste Tous Utilisateurs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/?route=/api/admin/utilisateurs"
          }
        },
        {
          "name": "Liste Tous Contenus",
          "request": {
