                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nomPseudo\": \"Petit Lucas\",\n  \"age\": 8,\n  \"avatar\": \"avatar1.png\"\n}"
            },
            "url": "{{baseUrl}}/?route=/api/enfants"
          }
        },
        {
          "name": "Détail Enfant",
          "request": {
            "method": "GET",
