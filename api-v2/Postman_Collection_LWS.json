              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/?route=/api/enfants/1"
          }
        }
      ]
    },
    {
      "name": "Contenus",
      "item": [
        {
          "name": "Liste Contenus",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/?route=/api/contenus"
          }
        },
        {
          "name": "Contenus par Catégorie",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/?route=/api/contenus&categorie=EDUCATIF"
          }
        },
        {
          "name": "Détail Contenu",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/?route=/api/contenus/1"
          }
        }
      ]
    },
    {
      "name": "Abonnements",
      "item": [
