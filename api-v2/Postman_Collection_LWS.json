          "name": "Liste Formules",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/?route=/api/abonnements/formules"
          }
        },
        {
          "name": "Mon Abonnement",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/?route=/api/abonnements/mon-abonnement"
          }
